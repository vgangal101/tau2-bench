        "country": "str",
        "zip": "str"
      },
      "output": {
        "entity": "Order",
        "cardinality": "single",
        "is_db_entity": true
      },
      "preconditions": [
        {
          "kind": "opaque_predicate",
          "predicate": "_is_pending_order",
          "table": "orders",
          "key_input": "order_id"
        }
      ],
      "effects": [
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "address",
          "to": "UserAddress(address1=address1, address2=address2, city=city, state=state, country=country, zip=zip)"
        }
      ]
    },
