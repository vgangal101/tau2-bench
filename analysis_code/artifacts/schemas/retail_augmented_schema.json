{
  "tools": {
    "cancel_pending_order": {
      "type": "write",
      "inputs": {
        "order_id": "str",
        "reason": "str"
      },
      "output": {
        "entity": "Order",
        "cardinality": "single",
        "is_db_entity": true
      },
      "preconditions": [
        {
          "kind": "field_equals",
          "table": "orders",
          "key_input": "order_id",
          "field": "status",
          "value": "pending"
        },
        {
          "kind": "input_in",
          "param": "reason",
          "values": [
            "no longer needed",
            "ordered by mistake"
          ]
        }
      ],
      "effects": [
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "status",
          "to": "cancelled"
        },
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "cancel_reason",
          "from_input": "reason"
        },
        {
          "kind": "list_append",
          "table": "orders",
          "key_input": "order_id",
          "field": "payment_history"
        }
      ]
    },
    "exchange_delivered_order_items": {
      "type": "write",
      "inputs": {
        "order_id": "str",
        "item_ids": "List[str]",
        "new_item_ids": "List[str]",
        "payment_method_id": "str"
      },
      "output": {
        "entity": "Order",
        "cardinality": "single",
        "is_db_entity": true
      },
      "preconditions": [
        {
          "kind": "field_equals",
          "table": "orders",
          "key_input": "order_id",
          "field": "status",
          "value": "delivered"
        }
      ],
      "effects": [
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "status",
          "to": "exchange requested"
        },
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "exchange_items",
          "to": "sorted(item_ids)"
        },
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "exchange_new_items",
          "to": "sorted(new_item_ids)"
        },
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "exchange_payment_method_id",
          "from_input": "payment_method_id"
        },
        {
          "kind": "field_set",
          "table": "orders",
          "key_input": "order_id",
          "field": "exchange_price_difference",
          "to": "diff_price"
        }
      ]
    },
