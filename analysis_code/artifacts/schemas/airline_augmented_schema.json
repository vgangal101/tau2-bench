{
  "tools": {
    "book_reservation": {
      "type": "write",
      "inputs": {
        "user_id": "str",
        "origin": "str",
        "destination": "str",
        "flight_type": "Literal['round_trip', 'one_way']",
        "cabin": "Literal['business', 'economy', 'basic_economy']",
        "flights": "List[FlightInfo | dict]",
        "passengers": "List[Passenger | dict]",
        "payment_methods": "List[Payment | dict]",
        "total_baggages": "int",
        "nonfree_baggages": "int",
        "insurance": "Literal['yes', 'no']"
      },
      "output": {
        "entity": "Reservation",
        "cardinality": "single",
        "is_db_entity": true
      },
      "preconditions": [],
      "effects": [
        {
          "kind": "record_create",
          "table": "reservations"
        },
        {
          "kind": "list_append_db",
          "table": "users",
          "field": "reservations"
        }
      ]
    },
    "cancel_reservation": {
